# Local PostgreSQL connection; never commit your populated .env.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/vpn_lens
# Optional local authorized IP2Location DB11 IPv4 CSV/ZIP for manual refreshes.
IP2LOCATION_CSV=data/IP2LOCATION-LITE-DB11.CSV
# Optional account download token enables automatic monthly DB11 LITE IPv4 CSV ZIP downloads.
# Obtain from your IP2Location account Download page; keep it only in local .env.
IP2LOCATION_DOWNLOAD_TOKEN=
# Optional authorized HTTPS ZIP URL override. Credentials remain only in .env.
# IP2LOCATION_DOWNLOAD_URL=
VPNLENS_CONNECT_TIMEOUT=5
VPNLENS_STATEMENT_TIMEOUT_MS=5000
# Explicit frontend origins, comma-separated. Empty disables cross-origin access.
VPNLENS_CORS_ORIGINS=

# Opt-in extended public evidence reads and publication.
VPNLENS_EXTENDED_EVIDENCE=false
